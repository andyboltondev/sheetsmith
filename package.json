{
  "name": "sheetsmith",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "test": "node --test --test-timeout=120000 test/*.test.ts",
    "start": "node src/server.ts",
    "dev": "node --watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "inspect-pdf": "node scripts/inspect-pdf.mjs",
    "test:update-snapshots": "UPDATE_SNAPSHOTS=1 node --test test/snapshot.test.ts",
    "check:js": "node scripts/check-js.mjs",
    "check": "npm run typecheck && npm run check:js && npm test",
    "coverage": "node --test --experimental-test-coverage test/*.test.ts"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.2",
    "axe-core": "^4.14.0",
    "jsdom": "^30.1.2",
    "typescript": "^7.0.2"
  }
}
